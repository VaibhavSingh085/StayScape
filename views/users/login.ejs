<% layout("/layouts/boilerplate.ejs") %>

<body>
    <div class="row">
    <div class="col-6 offset-3">
        <h1 class="col-6 offset-3">Login On Wanderlust</h1>
    <form method="POST" action="/login" class="needs-validation" novalidate>

        <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input placeholder="Enter username" name="username" id="username" class="form-control" required/>
        </div>
        <br>

        <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input placeholder="Enter password" name="password" class="form-control" required type="password" />
        </div>
        <br>

        <button class="btn btn-dark">Login</button>
        <br><br>
    </form>
    </div>
    </div>
</body>
</html>