<% layout("/layouts/boilerplate.ejs") %>

<body>
    <div class="row">
        <div class="col-8 offset-2">

            <form method="POST" action="/listings/<%= listing._id %>?_method=PATCH" class="needs-validation" novalidate enctype="multipart/form-data">

                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input 
                        placeholder="Enter place name" 
                        name="title" 
                        value="<%= listing.title %>" 
                        class="form-control" 
                        required
                    />
                    <div class="valid-feedback">The Title looks good.</div>
                    <div class="invalid-feedback">Please enter a valid title.</div>
                </div>

                <br>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea 
                        placeholder="Enter description of place" 
                        name="description" 
                        class="form-control" 
                        required
                    ><%= listing.description %></textarea>
                    <div class="valid-feedback">The Description looks good.</div>
                    <div class="invalid-feedback">Please enter a valid description.</div>
                </div>

                <br>
                <div>
                    <img src="<%=originalImageURL%>">
                </div>
                <br>

                <div class="mb-3">
                    <label for="image" class="form-label">Upload New Image</label>
                    <input 
                        placeholder="Enter Image Link" 
                        name="image" 
                        type="file"
                        class="form-control"
                    />
                </div>

                <br>

                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="price" class="form-label">Price</label>
                        <input 
                            placeholder="Enter price" 
                            name="price" 
                            type="number" 
                            value="<%= listing.price %>" 
                            class="form-control" 
                            required
                        />
                        <div class="valid-feedback">Looks good.</div>
                        <div class="invalid-feedback">Please enter a valid price.</div>
                    </div>

                    <div class="mb-3 col-md-6">
                        <label for="country" class="form-label">Country</label>
                        <input 
                            placeholder="Enter country" 
                            name="country" 
                            value="<%= listing.country %>" 
                            class="form-control" 
                            required
                        />
                        <div class="valid-feedback">Looks good.</div>
                        <div class="invalid-feedback">Please enter a valid country.</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input 
                        placeholder="Enter location" 
                        name="location" 
                        value="<%= listing.location %>" 
                        class="form-control" 
                        required
                    />
                    <div class="valid-feedback">Looks good.</div>
                    <div class="invalid-feedback">Please enter a valid location.</div>
                </div>

                <button class="btn btn-dark">Update</button>

            </form>
        </div>
    </div>
</body>
</html>