<% layout("/layouts/boilerplate.ejs") %>

<body>
    <div class="row">
    <div class="col-8" offset-2>
    <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">

        <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input placeholder="Enter place name" name="title" class="form-control" required/>
        <div class="valid-feedback">The Title looks good.</div>
        <div class="invalid-feedback">Please enter a title.</div>
        </div>
        <br>

        <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea placeholder="Enter description of place" name="description" class="form-control" required></textarea>
        <div class="valid-feedback">The Description looks good.</div>
        <div class="invalid-feedback">Please enter the description.</div>
        </div>
        <br>

        <div class="mb-3">
        <label for="image" class="form-label">Upload Image</label>
        <input name="image" type="file" class="form-control" required/>
        </div>
        <br>

        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input placeholder="Enter price" name="price" type="number" class="form-control" required/>
            <div class="invalid-feedback">Please enter a valid price.</div>
            <br>
            </div>

            <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input placeholder="Enter country: " name="country" class="form-control" required/>
            <div class="invalid-feedback">Please enter a valid country.</div>
            <br>
            </div>
        </div>

        <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input placeholder="Enter location: " name="location" class="form-control" required/>
        <div class="invalid-feedback">Please enter a valid location.</div>
        <br>
        </div>

        <div class="mb-3">
        <label for="category" class="form-label">Category</label>
        <select name="category" class="form-select" required>
            <option value="" selected disabled>Select category</option>
            <option value="Rooms">Rooms</option>
            <option value="EntireHomes">Entire Homes</option>
            <option value="Cabins">Cabins</option>
            <option value="Beachfront">Beachfront</option>
            <option value="Mountains">Mountains</option>
            <option value="Countryside">Countryside</option>
            <option value="Pools">Pools</option>
            <option value="Camping">Camping</option>
            <option value="Farms">Farms</option>
            <option value="Castles">Castles</option>
            <option value="Apartments">Apartments</option>
            <option value="Hotels">Hotels</option>
            <option value="Tropical">Tropical</option>
            <option value="Skiing">Skiing</option>
            <option value="Others">Others</option>
        </select>
        <div class="valid-feedback">Please Note: Once a category is selected it can't be changed again.</div>
        <div class="invalid-feedback">Please select a category.</div>
        <br>
        </div>

        <button class="btn btn-dark">Submit</button>
        <br><br>
    </form>
    </div>
    </div>
</body>
</html>